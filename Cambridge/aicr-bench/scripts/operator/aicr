#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  scripts/operator/aicr --help
  scripts/operator/aicr render <gds|gpu-topology|nccl-suite|elbencho|nccl-local|nccl-rdma|campaign|nodes> [options]
  scripts/operator/aicr archive <list|show|verify|extract> [options]
  scripts/operator/aicr doctor repo-root [options]

Role:
  Maintainer CLI for rendering reports, inspecting archives, and checking repo hygiene.
  It does not launch benchmark studies; use Make targets for verification and benchmark execution.

Commands:
  render gds           Re-render the newest matching GDS fleet report manifest.
  render gpu-topology  Re-render the newest matching GPU topology fleet report manifest.
  render nccl-suite    Re-render the newest matching NCCL suite scale report manifest.
  render elbencho      Re-render Benchmark 0 elbencho storage benchmark summaries.
  render nccl-local    Re-render the newest matching NCCL local fleet report manifest.
  render nccl-rdma     Re-render the newest matching B200 NCCL RDMA fleet report manifest.
  render campaign      Render a system verification campaign summary from committed reports.
  render nodes         Render a by-node system verification summary from committed reports.
  archive              Discover, inspect, verify, and extract retained result archives.
  doctor repo-root     Check repo-root cleanliness expectations.

Run a command with --help for exact syntax.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    -h|--help)
      usage
      exit 0
      ;;
    "")
      usage >&2
      exit 2
      ;;
    render)
      shift
      # shellcheck disable=SC1091
      source "${AICR_OPERATOR_DIR}/commands/render.sh"
      aicr_operator_render "$@"
      ;;
    archive)
      shift
      # shellcheck disable=SC1091
      source "${AICR_OPERATOR_DIR}/commands/archive.sh"
      aicr_operator_archive "$@"
      ;;
    doctor)
      shift
      # shellcheck disable=SC1091
      source "${AICR_OPERATOR_DIR}/commands/doctor.sh"
      aicr_operator_doctor "$@"
      ;;
    *)
      echo "ERROR: unknown command: ${command}" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
