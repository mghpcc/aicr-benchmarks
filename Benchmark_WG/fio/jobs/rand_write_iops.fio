; Peak random write IOPS.
;
; 4 KiB blocks, deep queue, many parallel jobs.
;
; Cache bypass:
;   direct=1        — bypass client page cache (O_DIRECT)
;   invalidate=1    — invalidate any stale client cache before run
;   fadvise_hint=1  — hint kernel POSIX_FADV_DONTNEED on written pages
;   end_fsync=${END_FSYNC} — 1 = honest (wait for server commit); 0 = let
;                   buffered NFS ack before commit (inflates IOPS, useful
;                   only for spec comparison)
;
; Required env vars: DATA_DIR, SIZE_PER_JOB, NUMJOBS, RUNTIME, RAMP_TIME,
;                    IODEPTH, IOENGINE, CPUS_ALLOWED, NRFILES, JOBNAME,
;                    END_FSYNC

[global]
ioengine=${IOENGINE}
direct=1
bs=4k
rw=randwrite
size=${SIZE_PER_JOB}
nrfiles=${NRFILES}
iodepth=${IODEPTH}
iodepth_batch_submit=8
iodepth_batch_complete=8
numjobs=${NUMJOBS}
group_reporting=1
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP_TIME}
directory=${DATA_DIR}
filename_format=fio.$jobname.$jobnum.$filenum
fallocate=none
invalidate=1
fadvise_hint=1
end_fsync=${END_FSYNC}
randrepeat=0
norandommap=1
thread=1
cpus_allowed=${CPUS_ALLOWED}
cpus_allowed_policy=split

[${JOBNAME}]
stonewall
