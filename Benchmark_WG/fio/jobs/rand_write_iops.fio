; Peak random write IOPS.
;
; 4 KiB blocks, deep queue, many parallel jobs.
;
; Required env vars: DATA_DIR, SIZE_PER_JOB, NUMJOBS, RUNTIME, RAMP_TIME,
;                    IODEPTH, IOENGINE, CPUS_ALLOWED

[global]
ioengine=${IOENGINE}
direct=1
bs=4k
rw=randwrite
size=${SIZE_PER_JOB}
iodepth=${IODEPTH}
iodepth_batch_submit=8
iodepth_batch_complete=8
numjobs=${NUMJOBS}
group_reporting=1
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP_TIME}
directory=${DATA_DIR}
filename_format=fio.$jobname.$jobnum
fallocate=none
end_fsync=1
randrepeat=0
norandommap=1
thread=1
cpus_allowed=${CPUS_ALLOWED}
cpus_allowed_policy=split

[rand_write]
stonewall
