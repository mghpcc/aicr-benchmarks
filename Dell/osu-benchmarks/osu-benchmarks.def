Bootstrap: docker
From: rockylinux/rockylinux:9.6

%labels
    Author          RedLine Performance Solutions
    Version         1.0
    UCX_VERSION     1.17.0
    OMPI_VERSION    5.0.6
    OSU_VERSION     7.5.2
    Description     OSU Micro-Benchmarks with InfiniBand

%arguments
    UCX_VERSION=1.17.0
    OMPI_VERSION=5.0.6
    OSU_VERSION=7.5.2
    INSTALL_PREFIX=/opt/hpc

%environment
    export INSTALL_PREFIX=/opt/hpc
    export UCX_HOME=${INSTALL_PREFIX}/ucx
    export OMPI_HOME=${INSTALL_PREFIX}/openmpi
    export OSU_HOME=${INSTALL_PREFIX}/osu

    export PATH=${OMPI_HOME}/bin:${UCX_HOME}/bin:${PATH}
    export LD_LIBRARY_PATH=${OMPI_HOME}/lib:${UCX_HOME}/lib:${LD_LIBRARY_PATH}
    export MANPATH=${OMPI_HOME}/share/man:${MANPATH}

    export UCX_WARN_UNUSED_ENV_VARS=n

%files
    /etc/yum.repos.d/*.repo /etc/yum.repos.d/

%post
    set -euo pipefail

    INSTALL_PREFIX=/opt/hpc
    UCX_VERSION={{ UCX_VERSION }}
    OMPI_VERSION={{ OMPI_VERSION }}
    OSU_VERSION={{ OSU_VERSION }}
    NCPU=$(nproc)

    # ── 0. Repo configuration — remove base-image defaults, use host repos ────
    rm -f /etc/yum.repos.d/Rocky-*.repo
    dnf clean all

    # ── 1. System packages ────────────────────────────────────────────────────
    dnf install -y dnf-plugins-core

    dnf install -y \
        gcc gcc-c++ gcc-gfortran make automake autoconf libtool pkgconfig \
        wget tar bzip2 gzip \
        git ca-certificates \
        libibverbs libibverbs-devel \
        librdmacm librdmacm-devel \
        rdma-core rdma-core-devel \
        infiniband-diags \
        libnl3 libnl3-devel \
        numactl numactl-devel \
        hwloc hwloc-devel \
        libevent libevent-devel \
        zlib-devel \
        openssh-clients \
        pmix pmix-devel            2>/dev/null || \
    dnf install -y \
        gcc gcc-c++ gcc-gfortran make automake autoconf libtool pkgconfig \
        wget curl tar bzip2 gzip \
        git ca-certificates \
        libibverbs libibverbs-devel \
        librdmacm librdmacm-devel \
        rdma-core rdma-core-devel \
        infiniband-diags \
        libnl3 libnl3-devel \
        numactl numactl-devel \
        hwloc hwloc-devel \
        libevent libevent-devel \
        zlib-devel \
        openssh-clients
    # pmix-devel may not be in EPEL on all minor releases — tolerate absence

    # ── 2. Build UCX (IB verbs only, no CUDA) ────────────────────────────────
    mkdir -p ${INSTALL_PREFIX}/src && cd ${INSTALL_PREFIX}/src
    wget -q https://github.com/openucx/ucx/releases/download/v${UCX_VERSION}/ucx-${UCX_VERSION}.tar.gz
    tar xf ucx-${UCX_VERSION}.tar.gz
    cd ucx-${UCX_VERSION}

    ./configure \
        --prefix=${INSTALL_PREFIX}/ucx \
        --with-verbs \
        --with-rdmacm \
        --without-cuda \
        --enable-mt \
        --enable-optimizations \
        --disable-logging \
        --disable-debug \
        --disable-assertions \
        --disable-params-check \
        CC=gcc CXX=g++

    make -j${NCPU}
    make install

    export PATH=${INSTALL_PREFIX}/ucx/bin:${PATH}
    export LD_LIBRARY_PATH=${INSTALL_PREFIX}/ucx/lib:${LD_LIBRARY_PATH}

    # ── 3. Build OpenMPI (with UCX + PMIx, no CUDA) ──────────────────────────
    # Same PMIx version check as GPU container — Rocky 9 system PMIx may be
    # too old for OpenMPI 5.x (requires >= 4.2.0); fall back to internal.
    cd ${INSTALL_PREFIX}/src
    wget -q https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OMPI_VERSION}.tar.bz2
    tar xf openmpi-${OMPI_VERSION}.tar.bz2
    cd openmpi-${OMPI_VERSION}

    if pkg-config --exists pmix 2>/dev/null && \
       pkg-config --atleast-version=4.2.0 pmix 2>/dev/null; then
        PMIX_FLAG="--with-pmix=$(pkg-config --variable=prefix pmix)"
    else
        PMIX_FLAG="--with-pmix=internal"
    fi

    ./configure \
        --prefix=${INSTALL_PREFIX}/openmpi \
        --with-ucx=${INSTALL_PREFIX}/ucx \
        --without-cuda \
        ${PMIX_FLAG} \
        --with-hwloc \
        --with-libevent \
        --without-verbs \
        --enable-shared \
        CC=gcc CXX=g++ FC=gfortran

    make -j${NCPU}
    make install

    export PATH=${INSTALL_PREFIX}/openmpi/bin:${PATH}
    export LD_LIBRARY_PATH=${INSTALL_PREFIX}/openmpi/lib:${LD_LIBRARY_PATH}

    # ── 4. Build OSU Micro-Benchmarks (CPU only, no CUDA) ────────────────────
    cd ${INSTALL_PREFIX}/src
    wget -q https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz
    tar xf osu-micro-benchmarks-${OSU_VERSION}.tar.gz
    cd osu-micro-benchmarks-${OSU_VERSION}

    ./configure \
        CC=${INSTALL_PREFIX}/openmpi/bin/mpicc \
        CXX=${INSTALL_PREFIX}/openmpi/bin/mpicxx \
        --prefix=${INSTALL_PREFIX}/osu

    make -j${NCPU}
    make install

    # ── 5. Cleanup build artifacts (reduce image size) ────────────────────────
    rm -rf ${INSTALL_PREFIX}/src

    # ── 6. Convenience symlinks for common benchmarks ─────────────────────────
    OSU_PT2PT=${INSTALL_PREFIX}/osu/libexec/osu-micro-benchmarks/mpi/pt2pt
    ln -sf ${OSU_PT2PT}/osu_bibw    /usr/local/bin/osu_bibw
    ln -sf ${OSU_PT2PT}/osu_bw      /usr/local/bin/osu_bw
    ln -sf ${OSU_PT2PT}/osu_latency /usr/local/bin/osu_latency
    ln -sf ${OSU_PT2PT}/osu_mbw_mr  /usr/local/bin/osu_mbw_mr

    echo "==> Build complete. Installed to ${INSTALL_PREFIX}"
    ${INSTALL_PREFIX}/openmpi/bin/mpirun --version
    ${INSTALL_PREFIX}/ucx/bin/ucx_info -v

%runscript
    exec "$@"

%help
    OSU Micro-Benchmarks container (InfiniBand only — no CUDA/GPU)
    For use on CPU-only nodes. Much smaller image than the GPU variant (~1-2 GB vs 8-12 GB).

    Key binaries:
      osu_bibw        Bidirectional bandwidth
      osu_bw          Unidirectional bandwidth
      osu_latency     Point-to-point latency

    Buffer types:
      H   Host (CPU) memory only — GPU buffers (D) are NOT supported in this build

    Examples:
      # CPU <-> CPU over IB
      srun --mpi=pmix apptainer exec --bind /dev/infiniband osu-benchmarks-cpu.sif osu_bibw H H

      # Interactive UCX diagnostics
      apptainer exec --bind /dev/infiniband osu-benchmarks-cpu.sif ucx_info -d
